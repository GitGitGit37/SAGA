# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Or use Gemini instead (only used when ANTHROPIC_API_KEY is empty)
GEMINI_API_KEY=

# Postgres (matches docker-compose.yml defaults)
POSTGRES_USER=cattrack
POSTGRES_PASSWORD=cattrack
POSTGRES_DB=cattrack
DATABASE_URL=postgresql+psycopg://cattrack:cattrack@localhost:5432/cattrack

# LLM models
CLAUDE_FAST_MODEL=claude-sonnet-5-5
CLAUDE_REASONING_MODEL=claude-opus-5-5
GEMINI_FAST_MODEL=gemini-flash-latest
GEMINI_REASONING_MODEL=gemini-flash-latest

# Use the LLM (instead of rules) for the initial inferences on first docker compose up
SEED_WITH_CLAUDE=0
